#!/bin/sh
# Credentials are supplied locally on the FAT boot partition, never in GitHub.
set -eu
mkdir -p /tmp/repeater-boot
mount -t vfat -o ro /dev/mmcblk0p1 /tmp/repeater-boot || exit 1
SEED=/tmp/repeater-boot/repeater.seed
[ -f "$SEED" ] || { umount /tmp/repeater-boot; exit 1; }
{
    IFS= read -r UPLINK_SSID
    IFS= read -r WIFI_KEY
    IFS= read -r AP_SSID
    IFS= read -r COUNTRY
    IFS= read -r ROOT_HASH
} < "$SEED"
umount /tmp/repeater-boot
[ -n "$UPLINK_SSID" ] && [ ${#WIFI_KEY} -ge 8 ] && [ -n "$ROOT_HASH" ] || exit 1

# Let OpenWrt discover persistent hardware paths; do not assume radio numbering.
ONBOARD=''
USB=''
for attempt in 1 2 3 4 5 6; do
    /sbin/wifi config
    for radio in $(uci show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
        path=$(uci -q get "wireless.$radio.path" || true)
        case "$path" in
            *usb*) USB="$radio" ;;
            *mmc*|*sdio*) ONBOARD="$radio" ;;
        esac
    done
    [ -n "$ONBOARD" ] && [ -n "$USB" ] && break
    sleep 5
done
[ -n "$ONBOARD" ] && [ -n "$USB" ] || exit 1

WAN_ZONE=''
for zone in $(uci show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
    [ "$(uci -q get "firewall.$zone.name" || true)" = wan ] && WAN_ZONE="$zone"
done
[ -n "$WAN_ZONE" ] || exit 1
while uci -q delete 'wireless.@wifi-iface[0]'; do :; done
uci set "wireless.$ONBOARD.disabled=0"
uci set "wireless.$ONBOARD.country=$COUNTRY"
uci set "wireless.$ONBOARD.channel=auto"
uci set "wireless.$USB.disabled=0"
uci set "wireless.$USB.country=$COUNTRY"
uci set "wireless.$USB.band=5g"
uci set "wireless.$USB.channel=36"
uci set "wireless.$USB.htmode=HE80"
uci set wireless.repeater_uplink=wifi-iface
uci set "wireless.repeater_uplink.device=$ONBOARD"
uci set wireless.repeater_uplink.mode=sta
uci set wireless.repeater_uplink.network=wwan
uci set "wireless.repeater_uplink.ssid=$UPLINK_SSID"
uci set wireless.repeater_uplink.encryption=psk2
uci set "wireless.repeater_uplink.key=$WIFI_KEY"
uci set wireless.repeater_uplink.disabled=0
uci set wireless.repeater_ap=wifi-iface
uci set "wireless.repeater_ap.device=$USB"
uci set wireless.repeater_ap.mode=ap
uci set wireless.repeater_ap.network=lan
uci set "wireless.repeater_ap.ssid=$AP_SSID"
uci set wireless.repeater_ap.encryption=psk2
uci set "wireless.repeater_ap.key=$WIFI_KEY"
uci set wireless.repeater_ap.disabled=0
uci set network.wwan=interface
uci set network.wwan.proto=dhcp
uci set network.lan.proto=static
uci set network.lan.ipaddr=192.168.50.1
uci set network.lan.netmask=255.255.255.0
uci -q delete network.lan.gateway || true
uci -q delete network.lan.dns || true
uci set dhcp.lan.ignore=0
uci set dhcp.lan.interface=lan
uci set dhcp.lan.start=100
uci set dhcp.lan.limit=150
uci set dhcp.lan.leasetime=12h
uci -q del_list "firewall.$WAN_ZONE.network=wwan" || true
uci add_list "firewall.$WAN_ZONE.network=wwan"
uci set "firewall.$WAN_ZONE.masq=1"
uci set "firewall.$WAN_ZONE.mtu_fix=1"
uci set firewall.repeater_forward=forwarding
uci set firewall.repeater_forward.src=lan
uci set firewall.repeater_forward.dest=wan
uci commit wireless
uci commit network
uci commit dhcp
uci commit firewall
chmod 600 /etc/config/wireless
umask 077
awk -F: -v OFS=: -v hash="$ROOT_HASH" '$1 == "root" {$2=hash} {print}' /etc/shadow > /etc/shadow.repeater
mv /etc/shadow.repeater /etc/shadow
logger -t repeater 'First-boot repeater settings applied successfully'
exit 0
